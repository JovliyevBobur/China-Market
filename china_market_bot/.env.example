# ==========================================
# 🛒 China Market Bot - Environment Variables
# ==========================================

# Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321
BOT_USERNAME=china_market_bot

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=china_market
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Security
SECRET_KEY=your_super_secret_key_here_min_32_chars
ENCRYPTION_KEY=your_encryption_key_here_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Payment - Telegram Stars
TELEGRAM_STARS_ENABLED=true

# Payment - Payme
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key
PAYME_TEST_MODE=true

# Payment - Click
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SERVICE_ID=your_click_service_id
CLICK_SECRET_KEY=your_click_secret_key
CLICK_TEST_MODE=true

# Media Storage
MEDIA_PATH=/app/media
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp

# Logging
LOG_LEVEL=INFO
LOG_PATH=/app/logs
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_PERIOD=60
BAN_TIME_SECONDS=300

# Localization
DEFAULT_LANGUAGE=uz
SUPPORTED_LANGUAGES=uz,ru,en

# Webhook (optional, for production)
WEBHOOK_HOST=https://your-domain.com
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8443
USE_WEBHOOK=false

# Development
DEBUG=false
